+func _baseline_active_bt_players() -> int:
+	var count := 0
+	for player in engine.entity_service.data.brain_player:
+		if player != null and player.active:
+			count += 1
+	return count
+
+func _baseline_valid_entities() -> int:
+	var data: AnimalData = engine.entity_service.data
+	var count := 0
+	var lower := Vector2(12.0, 94.0)
+	var upper: Vector2 = engine.config.arena_size - Vector2(12.0, 58.0)
+	for row in range(data.active_count):
+		var position := data.motion_position[row]
+		if position.is_finite() and position == position.clamp(lower, upper) and not data.motion_velocity[row].is_zero_approx() and data.brain_view[row].global_position.is_equal_approx(position):
+			count += 1
+	return count
