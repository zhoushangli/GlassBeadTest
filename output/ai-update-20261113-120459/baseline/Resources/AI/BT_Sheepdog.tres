[gd_resource type="BehaviorTree" format=3]

[ext_resource type="Script" path="res://Scripts/AI/Tasks/AnimalCondition.gd" id="1"]
[ext_resource type="Script" path="res://Scripts/AI/Tasks/AnimalAction.gd" id="2"]

[sub_resource type="BTCondition" id="Condition_0_0"]
script = ExtResource("1")
fact = &"must_return"

[sub_resource type="BTAction" id="Action_0"]
script = ExtResource("2")
behavior = 10

[sub_resource type="BTDynamicSequence" id="Branch_0"]
custom_name = "Return within leash"
children = [SubResource("Condition_0_0"), SubResource("Action_0")]

[sub_resource type="BTCondition" id="Condition_1_0"]
script = ExtResource("1")
fact = &"has_threat"

[sub_resource type="BTCondition" id="Condition_1_1"]
script = ExtResource("1")
fact = &"needs_intercept"

[sub_resource type="BTAction" id="Action_1"]
script = ExtResource("2")
behavior = 8

[sub_resource type="BTDynamicSequence" id="Branch_1"]
custom_name = "Intercept the threat"
children = [SubResource("Condition_1_0"), SubResource("Condition_1_1"), SubResource("Action_1")]

[sub_resource type="BTCondition" id="Condition_2_0"]
script = ExtResource("1")
fact = &"has_threat"

[sub_resource type="BTAction" id="Action_2"]
script = ExtResource("2")
behavior = 9

[sub_resource type="BTDynamicSequence" id="Branch_2"]
custom_name = "Drive away the wolf"
children = [SubResource("Condition_2_0"), SubResource("Action_2")]

[sub_resource type="BTAction" id="Action_3"]
script = ExtResource("2")
behavior = 7

[sub_resource type="BTDynamicSequence" id="Branch_3"]
custom_name = "Patrol the flock"
children = [SubResource("Action_3")]

[sub_resource type="BTDynamicSelector" id="Root"]
custom_name = "Sheepdog priorities"
children = [SubResource("Branch_0"), SubResource("Branch_1"), SubResource("Branch_2"), SubResource("Branch_3")]

[resource]
description = "Stay near the flock; intercept threats before driving them away."
root_task = SubResource("Root")
